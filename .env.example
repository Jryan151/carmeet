# Copy to .env and fill in. Nothing secret ever goes in the code.

PORT=4100
# The site's own name and domain (the neutral one, not Online Kitchen's). Placeholders until you pick them.
SITE_NAME=Meet Night
SITE_DOMAIN=meetnight.example
PUBLIC_SCHEME=https
TIMEZONE=America/Phoenix

DB_FILE=./data/meets.sqlite
UPLOAD_DIR=./data/uploads

# The food side (Online Kitchen). The same key goes in Online Kitchen's .env as MEET_PARTNER_KEY,
# and Online Kitchen's MEET_HOOK_URL points at https://<SITE_DOMAIN>/hooks/kitchen
KITCHEN_API=https://onlinekitchen.fyi
MEET_PARTNER_KEY=

# Email from the car meet domain (a second verified domain in the same Resend account, with its own send-only key).
RESEND_API_KEY=
MAIL_FROM=Meet Night <meets@meetnight.example>

# Your own admin calls (turning on a host's custom domain). Typed into the request, never stored.
ADMIN_TOKEN=

# Local testing only: sign-in codes come back in the answer instead of by email. Never on the live server.
DEV_CODES=

# Signs unsubscribe links (any long random string: openssl rand -hex 24). Keep it the same across restarts.
LINK_SECRET=

# Your own email: signed in with it, the portal also lets you set the front page's background video.
SITE_OWNER_EMAIL=

# The page azmonarchy.com opens on (a host's slug). Left empty, the site opens on its only host when there's just one.
HOME_HOST=
# Meet mode: trucks' menus open through /meet/* from the food side (needs the food side's meet mode first). 1 = on.
MEET_MODE=
# Where the food side answers on this server (meet mode passes /meet/* here). Defaults to KITCHEN_API.
KITCHEN_LOCAL=http://127.0.0.1:3000
# Food vendor profiles on their own address (<name>.<SITE_DOMAIN>), after the wildcard DNS record and Caddy's
# on-demand block are in place (README). Empty: profiles are at /v/<name>. 1 = on.
VENDOR_SUBDOMAINS=
# The parking map (README › Parking map). Satellite tiles ({z}/{x}/{y}) and their credit; empty: Esri World Imagery.
MAP_TILES=
MAP_CREDIT=
# Address search (Nominatim-style); empty: OpenStreetMap's public Nominatim. GEOCODER_COUNTRIES=us keeps matches in the US.
GEOCODER_URL=
# Parking already on the map (OpenStreetMap's Overpass); empty: the public Overpass API.
OVERPASS_URL=
GEOCODER_COUNTRIES=us
